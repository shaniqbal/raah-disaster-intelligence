# RAAH environment variables. Copy to .env.local for local development.
# Never commit real values. All variables are read server-side only.

# Optional — Alibaba Cloud Model Studio (Qwen) for the Copilot narrative layer.
# Without a key the Copilot uses the deterministic, data-grounded explainer.
DASHSCOPE_API_KEY=
# International endpoint (default). Beijing: https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT_MS=12000

# Canonical public URL used for metadata (Open Graph). Set to your Vercel URL.
NEXT_PUBLIC_SITE_URL=
